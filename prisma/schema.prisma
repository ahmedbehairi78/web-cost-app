  date                   String
  currency               String?
  reference              String?
  note                   String?
  descriptionAr          String?  @map("description_ar")
  descriptionEn          String?  @map("description_en")
  projectId              String?  @map("project_id")
  contractId             String?  @map("contract_id")
  offsetChartOfAccountId String?  @map("offset_chart_of_account_id")
  offsetAccountCode      String?  @map("offset_account_code")
  offsetAccountName      String?  @map("offset_account_name")
  toBankAccountId        String?  @map("to_bank_account_id")
  transferScope          String?  @map("transfer_scope")
  transferChannel        String?  @map("transfer_channel")
  transferDirection      String?  @map("transfer_direction")
  instapayBeneficiary    String?  @map("instapay_beneficiary")
  instapayFee            Decimal? @map("instapay_fee") @db.Decimal(18, 3)
  adjustmentDirection    String?  @map("adjustment_direction")
  status                 String   @default("draft")
  glTransactionId        String?  @map("gl_transaction_id")
  postedGlReference      String?  @map("posted_gl_reference")
  reversalTransactionId  String?  @map("reversal_transaction_id")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id])

  @@index([bankAccountId])
  @@index([status])
  @@index([projectId])
  @@index([contractId])
  @@map("bank_movements")
}

model BankCheque {
  id                     String   @id
  direction              String
  bankAccountId          String   @map("bank_account_id")
  chequeNo               String   @map("cheque_no")
  payeeName              String?  @map("payee_name")
  amount                 Decimal  @db.Decimal(18, 3)
  issueDate              String   @map("issue_date")
  dueDate                String?  @map("due_date")
  status                 String   @default("draft")
  offsetChartOfAccountId String?  @map("offset_chart_of_account_id")
  projectId              String?  @map("project_id")
  contractId             String?  @map("contract_id")
  receivedIssueCredits   Json?    @map("received_issue_credits")
  glIssueTransactionId   String?  @map("gl_issue_transaction_id")
  glClearTransactionId   String?  @map("gl_clear_transaction_id")
  glRejectTransactionId  String?  @map("gl_reject_transaction_id")
  postedIssueReference   String?  @map("posted_issue_reference")
  postedClearReference   String?  @map("posted_clear_reference")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id])

  @@index([bankAccountId])
  @@index([status])
  @@index([projectId])
  @@index([contractId])
  @@map("bank_cheques")
}

model BankStatement {
  id             String   @id
  bankAccountId  String   @map("bank_account_id")
  periodStart    String   @map("period_start")
  periodEnd      String   @map("period_end")
  openingBalance Decimal  @map("opening_balance") @db.Decimal(18, 3)
  closingBalance Decimal? @map("closing_balance") @db.Decimal(18, 3)
  sourceLabel    String?  @map("source_label")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  bankAccount BankAccount         @relation(fields: [bankAccountId], references: [id])
  lines       BankStatementLine[]

  @@index([bankAccountId])
  @@map("bank_statements")
}

model BankStatementLine {
  id                String   @id
  statementId       String   @map("statement_id")
  lineDate          String   @map("line_date")
  reference         String?
  description       String?
  debit             Decimal  @default(0) @db.Decimal(18, 3)
  credit            Decimal  @default(0) @db.Decimal(18, 3)
