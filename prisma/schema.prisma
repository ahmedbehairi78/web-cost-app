  sentAt        DateTime? @map("sent_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  employee PayrollEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([employeeId])
  @@map("employee_notification_outbox")
}

model AttendanceRule {
  id                   String   @id @default(uuid())
  workingDaysPerMonth  Int      @default(26) @map("working_days_per_month")
  dailyWorkHours       Float    @default(8) @map("daily_work_hours")
  overtimeMultiplier   Float    @default(1.25) @map("overtime_multiplier")
  lateGraceMins        Int      @default(5) @map("late_grace_mins")
  lateTier1Mins        Int      @default(15) @map("late_tier1_mins")
  lateTier2Mins        Int      @default(30) @map("late_tier2_mins")
