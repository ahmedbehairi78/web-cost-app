  daysPaidLeave Decimal  @default(0) @map("days_paid_leave") @db.Decimal(18, 3)
  leaveBreakdown Json?   @map("leave_breakdown")
  lateMinutes   Decimal  @default(0) @map("late_minutes") @db.Decimal(18, 3)
  directPenalties Decimal @default(0) @map("direct_penalties") @db.Decimal(18, 3)
