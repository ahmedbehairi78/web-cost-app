model CustodySettlement {
  id                  String   @id @default(uuid())
  projectId           String   @map("project_id")
  settlementNumber    String   @unique @map("settlement_number")
  custodyAccountCode  String   @map("custody_account_code")
  custodyAccountName  String?  @map("custody_account_name")
