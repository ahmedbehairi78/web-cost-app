# Production build (Railway / CI). Copy to .env.production locally or set vars in Railway.
# Firebase keys: Console → Project settings → Your apps → Web app (public keys only).

VITE_DATA_BACKEND=local
VITE_API_BASE_URL=/api

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=gen-lang-client-0599011721
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
# Optional — only if using named Firestore DB for legacy scripts
# VITE_FIREBASE_DATABASE_ID=
