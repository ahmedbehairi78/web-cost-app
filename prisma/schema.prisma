// Banks module — Firestore bank_* collections mirrored for local/Postgres API
model BankAccount {
  id             String   @id
  coaAccountId   String?  @map("coa_account_id")
  code           String
  nameAr         String   @map("name_ar")
  nameEn         String?  @map("name_en")
