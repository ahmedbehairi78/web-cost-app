generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String   @id @default(uuid())
  email               String   @unique
  displayName         String?
  passwordHash        String   @map("password_hash")
  role                String   @default("user")
  permissions         Json
  assignedContractIds Json     @default("[]") @map("assigned_contract_ids")
  phoneE164           String?  @map("phone_e164")
  whatsappOptIn       Boolean  @default(false) @map("whatsapp_opt_in")
  preferredLanguage   String   @default("ar") @map("preferred_language")
  whatsappNotifyTypes Json     @default("[]") @map("whatsapp_notify_types")
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  auditLogs            AuditLog[]
  notificationReads    UserNotificationRead[]
  notificationOutbox   NotificationOutbox[]
  approvalLinkTokens   ApprovalLinkToken[]

  @@map("users")
}

model NotificationOutbox {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  notificationKey String    @map("notification_key")
  channel         String    @default("whatsapp")
  templateName    String    @map("template_name")
  payload         Json
  status          String    @default("pending")
  dedupeHash      String    @unique @map("dedupe_hash")
  attemptCount    Int       @default(0) @map("attempt_count")
  lastError       String?   @map("last_error")
  providerMsgId   String?   @map("provider_message_id")
  scheduledAt     DateTime  @default(now()) @map("scheduled_at")
  sentAt          DateTime? @map("sent_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, scheduledAt])
  @@index([notificationKey])
  @@map("notification_outbox")
}

model ApprovalLinkToken {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  notificationKey String    @map("notification_key")
  tokenHash       String    @unique @map("token_hash")
  expiresAt       DateTime  @map("expires_at")
  usedAt          DateTime? @map("used_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, notificationKey])
  @@map("approval_link_tokens")
}

model UserNotificationRead {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  notificationKey String    @map("notification_key")
  readAt          DateTime  @default(now()) @map("read_at")
  dismissedAt     DateTime? @map("dismissed_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, notificationKey])
  @@index([userId])
  @@map("user_notification_reads")
}

model Project {
  id            String   @id @default(uuid())
  projectCode   String   @unique @map("project_code")
  projectName   String   @map("project_name")
  projectNameEn String?  @map("project_name_en")
  clientName    String   @map("client_name")
  clientNameEn  String?  @map("client_name_en")
  status        String   @default("active")
  boqValue      Decimal  @default(0) @map("boq_value") @db.Decimal(18, 3)
  voValue       Decimal  @default(0) @map("vo_value") @db.Decimal(18, 3)
  budget        Decimal  @default(0) @db.Decimal(18, 3)
  isDeleted     Boolean  @default(false) @map("is_deleted")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  inventoryAccountCode String? @map("inventory_account_code")

  contracts            Contract[]
  boqItems             BoqItem[]
  billings             Billing[]
  transactions         Transaction[]
  purchaseTransactions PurchaseTransaction[]
  custodySettlements   CustodySettlement[]
  chartOfAccounts      ChartOfAccount[]
  purchaseInvoices     PurchaseInvoice[]
  projectInventory     ProjectInventory[]
  consumptionOrders    ConsumptionOrder[]
  returnOrders         ReturnOrder[]
  transfersFrom        ProjectInventoryTransfer[] @relation("TransferFromProject")
  transfersTo          ProjectInventoryTransfer[] @relation("TransferToProject")
  contractExpenseOrders ContractExpenseOrder[]
  documentRegistry      DocumentRegistry[]
  variationOrders       VariationOrder[]
  purchaseRequests      PurchaseRequest[]

  @@index([isDeleted, projectCode])
  @@index([inventoryAccountCode])
  @@map("projects")
}

model Contract {
  id             String   @id @default(uuid())
  projectId      String   @map("project_id")
  contractName   String   @map("contract_name")
  contractNameEn String?  @map("contract_name_en")
  contractNumber String   @map("contract_number")
  contractValue  Decimal  @default(0) @map("contract_value") @db.Decimal(18, 3)
  startDate      String?  @map("start_date")
  endDate        String?  @map("end_date")
  isDeleted      Boolean  @default(false) @map("is_deleted")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  project              Project               @relation(fields: [projectId], references: [id])
  boqItems             BoqItem[]
  billings             Billing[]
  purchaseTransactions PurchaseTransaction[]
  returnOrders         ReturnOrder[]
  costCenter           CostCenter?
  contractExpenseOrders ContractExpenseOrder[]
  overheadAllocationLines OverheadAllocationLine[]
  mosCertificates       MosCertificate[]
  documentRegistry      DocumentRegistry[]
  variationOrders       VariationOrder[]

  @@index([projectId, isDeleted])
  @@map("contracts")
}

model CostCenter {
  id         String   @id @default(uuid())
  code       String   @unique
  name       String
  nameEn     String?  @map("name_en")
  type       String
  contractId String?  @unique @map("contract_id")
  isActive   Boolean  @default(true) @map("is_active")
  isDeleted  Boolean  @default(false) @map("is_deleted")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  contract              Contract?              @relation(fields: [contractId], references: [id])
  transactions          Transaction[]
  journalEntries        JournalEntry[]
  indirectOverheadLines OverheadAllocationLine[] @relation("IndirectOverheadCenter")

  @@index([type, isDeleted])
  @@map("cost_centers")
}

model BoqItem {
  id               String   @id @default(uuid())
  projectId        String   @map("project_id")
  contractId       String?  @map("contract_id")
  chapterCode      String?  @map("chapter_code")
  chapterName      String?  @map("chapter_name")
  workTypeCode     String?  @map("work_type_code")
  sectionCode      String?  @map("section_code")
  sectionName      String?  @map("section_name")
  itemCode         String   @map("item_code")
  description      String
  unit             String
  tenderQty        Decimal  @default(0) @map("tender_qty") @db.Decimal(18, 3)
  rateMaterials    Decimal  @default(0) @map("rate_materials") @db.Decimal(18, 3)
  rateLabour       Decimal  @default(0) @map("rate_labour") @db.Decimal(18, 3)
  rateEquipment    Decimal  @default(0) @map("rate_equipment") @db.Decimal(18, 3)
  rateDirect       Decimal  @default(0) @map("rate_direct") @db.Decimal(18, 3)
  rateOverheadPct  Decimal  @default(10) @map("rate_overhead_pct") @db.Decimal(8, 2)
  rateProfitPct    Decimal  @default(12) @map("rate_profit_pct") @db.Decimal(8, 2)
  unitRateTotal    Decimal  @default(0) @map("unit_rate_total") @db.Decimal(18, 3)
  tenderAmount     Decimal  @default(0) @map("tender_amount") @db.Decimal(18, 3)
  expectedDuration Int?     @map("expected_duration")
  startDate        String?  @map("start_date")
  isDeleted        Boolean  @default(false) @map("is_deleted")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  project   Project           @relation(fields: [projectId], references: [id])
  contract  Contract?         @relation(fields: [contractId], references: [id])
  materials BoqItemMaterial[]
  variationOrderLines VariationOrderLine[] @relation("VoLineBoqItem")

  @@index([projectId, contractId, isDeleted])
  @@index([itemCode])
  @@map("boq_items")
}

model ChartOfAccount {
  id            String   @id @default(uuid())
  accountCode   String   @unique @map("account_code")
  accountName   String   @map("account_name")
  accountNameEn String?  @map("account_name_en")
  parentCode    String   @default("") @map("parent_code")
  type          String
  isGroup       Boolean  @default(false) @map("is_group")
  statementType String?  @map("statement_type")
  status        String   @default("active")
  supplierId    String?  @map("supplier_id")
  projectId     String?  @map("project_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  supplier Supplier? @relation(fields: [supplierId], references: [id])
  project  Project?  @relation(fields: [projectId], references: [id])

  @@index([parentCode])
  @@index([isGroup, status])
  @@index([projectId])
  @@map("chart_of_accounts")
}

model Supplier {
  id        String   @id @default(uuid())
  name      String
  nameEn    String?  @map("name_en")
  type      String
  taxNumber String?  @map("tax_number")
  phone     String?
  address   String?
  isDeleted Boolean  @default(false) @map("is_deleted")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  accounts             ChartOfAccount[]
  purchaseTransactions PurchaseTransaction[]

  @@index([type, isDeleted])
  @@map("suppliers")
}

model Transaction {
  id                      String   @id @default(uuid())
  date                    String
  description             String
  reference               String?
  projectId               String?  @map("project_id")
  costCenterId            String?  @map("cost_center_id")
  createdBy               String?  @map("created_by")
  reversesReference       String?  @map("reverses_reference")
  undoesReversalReference String?  @map("undoes_reversal_reference")
  /** null | fiscal_pl_close | fiscal_opening — opening excluded from rolling BS/IS aggregations */
  journalKind             String?  @map("journal_kind")
  isDeleted               Boolean  @default(false) @map("is_deleted")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  project                   Project?                   @relation(fields: [projectId], references: [id])
  costCenter                CostCenter?                @relation(fields: [costCenterId], references: [id])
  entries                   JournalEntry[]
  overheadAllocationLines   OverheadAllocationLine[]
  billings                  Billing[]
  purchaseTransactions      PurchaseTransaction[]
  projectInventoryTransfers ProjectInventoryTransfer[]
  mosExtracts               MaterialOnSiteExtract[]
  mosCertificates           MosCertificate[]
  contractExpenseOrders     ContractExpenseOrder[]
  fiscalPlClosings          FiscalPeriodClosing[]      @relation("FiscalPlCloseTx")
  fiscalOpenings            FiscalPeriodClosing[]      @relation("FiscalOpeningTx")

  @@index([isDeleted, date])
  @@index([projectId])
  @@index([costCenterId])
  @@index([reversesReference, isDeleted])
  @@index([journalKind, isDeleted])
  @@map("transactions")
}

model JournalEntry {
  id            String  @id @default(uuid())
  transactionId String  @map("transaction_id")
  lineNo        Int     @map("line_no")
  accountCode   String  @map("account_code")
  accountName   String? @map("account_name")
  debit         Decimal @default(0) @db.Decimal(18, 3)
  credit        Decimal @default(0) @db.Decimal(18, 3)
  costCenterId  String? @map("cost_center_id")

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  costCenter  CostCenter? @relation(fields: [costCenterId], references: [id])

  @@index([accountCode])
  @@index([costCenterId])
  @@map("journal_entries")
}

model Billing {
  id                     String   @id @default(uuid())
  projectId              String   @map("project_id")
  contractId             String   @map("contract_id")
  billingNumber          String   @map("billing_number")
  date                   String
  worksValueExVat        Decimal  @default(0) @map("works_value_ex_vat") @db.Decimal(18, 3)
  vatAmount              Decimal  @default(0) @map("vat_amount") @db.Decimal(18, 3)
  execGuaranteeAmount    Decimal  @default(0) @map("exec_guarantee_amount") @db.Decimal(18, 3)
  whtAmount              Decimal  @default(0) @map("wht_amount") @db.Decimal(18, 3)
  labourInsuranceAmount  Decimal  @default(0) @map("labour_insurance_amount") @db.Decimal(18, 3)
  manpowerLevyAmount     Decimal  @default(0) @map("manpower_levy_amount") @db.Decimal(18, 3)
  advancePaymentRecovery Decimal  @default(0) @map("advance_payment_recovery") @db.Decimal(18, 3)
  netPayable             Decimal  @default(0) @map("net_payable") @db.Decimal(18, 3)
  status                 String   @default("draft")
  transactionId          String?  @map("transaction_id")
  isDeleted              Boolean  @default(false) @map("is_deleted")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  project     Project       @relation(fields: [projectId], references: [id])
  contract    Contract      @relation(fields: [contractId], references: [id])
  transaction Transaction?  @relation(fields: [transactionId], references: [id])
  items       BillingItem[]

  @@index([contractId, isDeleted])
  @@index([status])
  @@map("billing")
}

model BillingItem {
  id          String  @id @default(uuid())
  billingId   String  @map("billing_id")
  boqItemId   String? @map("boq_item_id")
  itemCode    String  @map("item_code")
  description String
  unit        String
  rate        Decimal @default(0) @db.Decimal(18, 3)
  previousQty Decimal @default(0) @map("previous_qty") @db.Decimal(18, 3)
  currentQty  Decimal @default(0) @map("current_qty") @db.Decimal(18, 3)
  totalQty    Decimal @default(0) @map("total_qty") @db.Decimal(18, 3)
  amount      Decimal @default(0) @db.Decimal(18, 3)
  metadata    Json?

  billing Billing @relation(fields: [billingId], references: [id], onDelete: Cascade)

  @@map("billing_items")
}

model PurchaseTransaction {
  id                     String   @id @default(uuid())
  type                   String
  supplierId             String?  @map("supplier_id")
  supplierAccountId      String?  @map("supplier_account_id")
  supplierName           String   @map("supplier_name")
  projectId              String?  @map("project_id")
  contractId             String?  @map("contract_id")
  expenseAccountId       String?  @map("expense_account_id")
  expenseAccountName     String?  @map("expense_account_name")
  date                   String
  referenceNumber        String?  @map("reference_number")
  amount                 Decimal  @default(0) @db.Decimal(18, 3)
  vatAmount              Decimal  @default(0) @map("vat_amount") @db.Decimal(18, 3)
  whtAmount              Decimal  @default(0) @map("wht_amount") @db.Decimal(18, 3)
  execGuaranteeAmount    Decimal  @default(0) @map("exec_guarantee_amount") @db.Decimal(18, 3)
  labourInsuranceAmount  Decimal  @default(0) @map("labour_insurance_amount") @db.Decimal(18, 3)
  manpowerLevyAmount     Decimal  @default(0) @map("manpower_levy_amount") @db.Decimal(18, 3)
  advancePaymentRecovery Decimal  @default(0) @map("advance_payment_recovery") @db.Decimal(18, 3)
  totalAmount            Decimal  @default(0) @map("total_amount") @db.Decimal(18, 3)
  description            String?
  /** `credit` (آجلة) · `cash` (نقدية via 12102 custody/cash). Null = credit for legacy rows. */
  paymentType            String?  @map("payment_type")
  status                 String   @default("pending")
  transactionId          String?  @map("transaction_id")
  isDeleted              Boolean  @default(false) @map("is_deleted")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  supplier    Supplier?                 @relation(fields: [supplierId], references: [id])
  project     Project?                  @relation(fields: [projectId], references: [id])
  contract    Contract?                 @relation(fields: [contractId], references: [id])
  transaction Transaction?              @relation(fields: [transactionId], references: [id])
  items       PurchaseTransactionItem[]

  @@index([type, isDeleted])
  @@index([contractId])
  @@map("purchase_transactions")
}

model PurchaseTransactionItem {
  id                    String @id @default(uuid())
  purchaseTransactionId String @map("purchase_transaction_id")
  payload               Json

  purchaseTransaction PurchaseTransaction @relation(fields: [purchaseTransactionId], references: [id], onDelete: Cascade)

  @@map("purchase_transaction_items")
}

model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  before    Json?
  after     Json?
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_log")
}

// ───────────────────────────────────────────────────────────────────────────
// Financial core — mirrors server/sqlite/migrations 001–015
// NOTE: Postgres has no SQLite STORED-generated columns, CHECK constraints, or
// triggers. Computed balances (quantity_balance) are maintained in application
// code (Phase 2); the allocation-guard trigger and CHECK(qty>0) constraints
// are enforced at the service layer. A few SQLite columns referenced TEXT ids
// without a declared FK (mirror-ahead pattern) — those stay plain scalars here.
// ───────────────────────────────────────────────────────────────────────────

// migration 004 — materials tree
model MaterialGroup {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  categories MaterialCategory[]

  @@map("material_groups")
}

model MaterialCategory {
  id        Int      @id @default(autoincrement())
  groupId   Int      @map("group_id")
  code      String   @unique
  name      String
  unit      String
  createdAt DateTime @default(now()) @map("created_at")

  group MaterialGroup @relation(fields: [groupId], references: [id])

  boqItemMaterials              BoqItemMaterial[]
  purchaseInvoiceLines          PurchaseInvoiceLine[]
  contractInventory             ContractInventory[]
  consumptionOrderLines         ConsumptionOrderLine[]
  inventoryTransferLines        InventoryTransferLine[]
  projectInventory              ProjectInventory[]
  returnOrderLines              ReturnOrderLine[]
  projectInventoryTransferLines ProjectInventoryTransferLine[]

  @@index([groupId])
  @@map("material_categories")
}

// migration 004 — BOQ ↔ allowed materials
model BoqItemMaterial {
  id                 Int      @id @default(autoincrement())
  boqItemId          String   @map("boq_item_id")
  materialCategoryId Int      @map("material_category_id")
  createdAt          DateTime @default(now()) @map("created_at")

  boqItem          BoqItem          @relation(fields: [boqItemId], references: [id])
  materialCategory MaterialCategory @relation(fields: [materialCategoryId], references: [id])

  @@unique([boqItemId, materialCategoryId])
  @@index([boqItemId])
  @@index([materialCategoryId])
  @@map("boq_item_materials")
}

// migrations 004/005/006 — distributed purchase invoice header
model PurchaseInvoice {
  id            Int      @id @default(autoincrement())
  invoiceId     String   @unique @map("invoice_id")
  invoiceNumber String?  @map("invoice_number")
  invoiceDate   String   @map("invoice_date")
  supplierName  String?  @map("supplier_name")
  status        String   @default("draft")
  notes         String?
  vatPct        Decimal  @default(0) @map("vat_pct") @db.Decimal(18, 3)
  projectId     String?  @map("project_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  project Project? @relation(fields: [projectId], references: [id])

  @@index([status])
  @@index([invoiceDate])
  @@index([projectId])
  @@map("purchase_invoices")
}

// migrations 001/003/004 — invoice lines (invoice_id is TEXT, no FK in SQLite)
model PurchaseInvoiceLine {
  id                 Int      @id @default(autoincrement())
  invoiceId          String   @map("invoice_id")
  itemDescription    String   @map("item_description")
  unit               String
  quantity           Decimal  @db.Decimal(18, 3)
  unitCost           Decimal  @map("unit_cost") @db.Decimal(18, 3)
  totalCost          Decimal  @map("total_cost") @db.Decimal(18, 3)
  boqItemId          String?  @map("boq_item_id")
  materialCategoryId Int?     @map("material_category_id")
  createdAt          DateTime @default(now()) @map("created_at")

  materialCategory MaterialCategory?           @relation(fields: [materialCategoryId], references: [id])
  allocations      PurchaseInvoiceAllocation[]

  @@index([invoiceId])
  @@map("purchase_invoice_lines")
}

// migration 001 — per-contract allocation of each invoice line
model PurchaseInvoiceAllocation {
  id         Int      @id @default(autoincrement())
  lineId     Int      @map("line_id")
  contractId String   @map("contract_id")
  quantity   Decimal  @db.Decimal(18, 3)
  unitCost   Decimal  @map("unit_cost") @db.Decimal(18, 3)
  totalCost  Decimal  @map("total_cost") @db.Decimal(18, 3)
  createdAt  DateTime @default(now()) @map("created_at")

  line PurchaseInvoiceLine @relation(fields: [lineId], references: [id], onDelete: Cascade)

  @@unique([lineId, contractId])
  @@map("purchase_invoice_allocations")
}

// migrations 001/004 — legacy per-contract inventory (rebuilt in 004; merged into project_inventory in 009)
model ContractInventory {
  id                     Int      @id @default(autoincrement())
  contractId             String   @map("contract_id")
  materialCategoryId     Int?     @map("material_category_id")
  itemDescription        String?  @map("item_description")
  unit                   String
  quantityIn             Decimal  @default(0) @map("quantity_in") @db.Decimal(18, 3)
  quantityConsumed       Decimal  @default(0) @map("quantity_consumed") @db.Decimal(18, 3)
  quantityTransferredOut Decimal  @default(0) @map("quantity_transferred_out") @db.Decimal(18, 3)
  quantityTransferredIn  Decimal  @default(0) @map("quantity_transferred_in") @db.Decimal(18, 3)
  quantityReserved       Decimal  @default(0) @map("quantity_reserved") @db.Decimal(18, 3)
  avgUnitCost            Decimal  @default(0) @map("avg_unit_cost") @db.Decimal(18, 3)
  quantityBalance        Decimal  @default(0) @map("quantity_balance") @db.Decimal(18, 3)
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  materialCategory MaterialCategory?       @relation(fields: [materialCategoryId], references: [id])
  consumptions     InventoryConsumption[]
  transferLines    InventoryTransferLine[]

  @@index([contractId])
  @@index([contractId, materialCategoryId])
  @@map("contract_inventory")
}

// migration 001 — legacy consumption log against contract_inventory
model InventoryConsumption {
  id              Int      @id @default(autoincrement())
  inventoryItemId Int      @map("inventory_item_id")
  contractId      String   @map("contract_id")
  quantity        Decimal  @db.Decimal(18, 3)
  consumptionDate String   @map("consumption_date")
  boqItemId       String?  @map("boq_item_id")
  recordedBy      String   @map("recorded_by")
  createdAt       DateTime @default(now()) @map("created_at")

  inventoryItem ContractInventory @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@map("inventory_consumption")
}

// migrations 001/003/004 — legacy contract-to-contract transfers
model InventoryTransfer {
  id                 Int      @id @default(autoincrement())
  transferNumber     String   @unique @map("transfer_number")
  transferDate       String   @map("transfer_date")
  fromContractId     String   @map("from_contract_id")
  toContractId       String   @map("to_contract_id")
  status             String
  createdBy          String   @map("created_by")
  approvedByB        String?  @map("approved_by_b")
  approvedByProjects String?  @map("approved_by_projects")
  rejectionReason    String?  @map("rejection_reason")
  notes              String?
  createdAt          DateTime @default(now()) @map("created_at")

  lines InventoryTransferLine[]

  @@index([status])
  @@index([fromContractId, status])
  @@index([toContractId, status])
  @@map("inventory_transfers")
}

model InventoryTransferLine {
  id                 Int      @id @default(autoincrement())
  transferId         Int      @map("transfer_id")
  inventoryItemId    Int      @map("inventory_item_id")
  materialCategoryId Int?     @map("material_category_id")
  quantity           Decimal  @db.Decimal(18, 3)
  unitCost           Decimal  @map("unit_cost") @db.Decimal(18, 3)
