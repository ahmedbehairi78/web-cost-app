  @@map("bank_statement_lines")
}

// ─── Fixed Assets Module ────────────────────────────────────────────────────

model FixedAssetGroup {
  id                              Int      @id @default(autoincrement())
  groupName                       String   @map("group_name")
  defaultAssetAccountCode         String   @map("default_asset_account_code")
  defaultDepreciationAccountCode  String   @map("default_depreciation_account_code")
  defaultExpenseAccountCode       String   @map("default_expense_account_code")
  defaultDepreciationModel        String   @default("straight_line") @map("default_depreciation_model")
  defaultUsefulLifeYears          Decimal  @map("default_useful_life_years") @db.Decimal(18, 3)
  defaultAnnualRate               Decimal? @map("default_annual_rate") @db.Decimal(18, 6)
  isDeleted                       Boolean  @default(false) @map("is_deleted")
  createdAt                       DateTime @default(now()) @map("created_at")
  updatedAt                       DateTime @updatedAt @map("updated_at")

  assets FixedAsset[]

  @@map("fixed_asset_groups")
}

model FixedAsset {
  id                                String   @id @default(uuid())
  assetNumber                       String   @unique @map("asset_number")
  assetName                         String   @map("asset_name")
  groupId                           Int?     @map("group_id")
  acquisitionDate                   String   @map("acquisition_date")
  assetValue                        Decimal  @map("asset_value") @db.Decimal(18, 3)
  salvageValue                      Decimal  @default(0) @map("salvage_value") @db.Decimal(18, 3)
  usefulLifeYears                   Decimal  @map("useful_life_years") @db.Decimal(18, 3)
  depreciationModel                 String   @map("depreciation_model")
  annualDepreciationRate            Decimal  @map("annual_depreciation_rate") @db.Decimal(18, 6)
  assetAccountCode                  String   @map("asset_account_code")
  assetAccountName                  String?  @map("asset_account_name")
  accumulatedDepreciationAccountCode String  @map("accumulated_depreciation_account_code")
  accumulatedDepreciationAccountName String? @map("accumulated_depreciation_account_name")
  expenseAccountCode                String   @map("expense_account_code")
  expenseAccountName                String?  @map("expense_account_name")
  costCenterId                      String?  @map("cost_center_id")
  costCenterType                    String?  @map("cost_center_type")
  bookValue                         Decimal  @map("book_value") @db.Decimal(18, 3)
  openingAccumulatedDepr            Decimal  @default(0) @map("opening_accumulated_depr") @db.Decimal(18, 3)
  status                            String   @default("pending_setup") @map("status")
  purchaseTransactionId             String?  @map("purchase_transaction_id")
  notes                             String?
  isDeleted                         Boolean  @default(false) @map("is_deleted")
  createdAt                         DateTime @default(now()) @map("created_at")
  updatedAt                         DateTime @updatedAt @map("updated_at")

  group               FixedAssetGroup?               @relation(fields: [groupId], references: [id])
  depreciationEntries FixedAssetDepreciationEntry[]

  @@index([status])
  @@index([groupId])
  @@index([assetAccountCode])
  @@map("fixed_assets")
}

model FixedAssetDepreciationEntry {
  id                 Int      @id @default(autoincrement())
  assetId            String   @map("asset_id")
  periodLabel        String   @map("period_label")
  periodStart        String   @map("period_start")
  periodEnd          String   @map("period_end")
  depreciationAmount Decimal  @map("depreciation_amount") @db.Decimal(18, 3)
  bookValueBefore    Decimal  @map("book_value_before") @db.Decimal(18, 3)
  bookValueAfter     Decimal  @map("book_value_after") @db.Decimal(18, 3)
  transactionId      String?  @map("transaction_id")
  status             String   @default("posted") @map("status")
  createdAt          DateTime @default(now()) @map("created_at")

  asset FixedAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([periodLabel])
  @@map("fixed_asset_depreciation_entries")
}

// ─── HR / Payroll Module ────────────────────────────────────────────────────

model PayrollEmployee {
  id                       String   @id @default(uuid())
  employeeCode             String   @unique @map("employee_code")
  name                     String
  nameEn                   String?  @map("name_en")
  department               String?
  jobTitle                 String?  @map("job_title")
  defaultCostCenterId      String?  @map("default_cost_center_id")
  defaultCostCenterType    String?  @map("default_cost_center_type")
  defaultExpenseAccountCode String? @map("default_expense_account_code")
  defaultExpenseAccountName String? @map("default_expense_account_name")
  basicSalary              Decimal  @default(0) @map("basic_salary") @db.Decimal(18, 3)
  hireDate                 String?  @map("hire_date")
  birthDate                String?  @map("birth_date")
  priorInsuranceMonths     Int?     @map("prior_insurance_months")
  phoneE164                String?  @map("phone_e164")
  whatsappOptIn            Boolean  @default(false) @map("whatsapp_opt_in")
  status                   String   @default("active") @map("status")
  notes                    String?
  isDeleted                Boolean  @default(false) @map("is_deleted")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  lines                PayrollRunLine[]
  leaveBalances        EmployeeLeaveBalance[]
  costCenterAllocations EmployeeCostCenterAllocation[]
  notificationOutbox   EmployeeNotificationOutbox[]

  @@index([status])
  @@index([department])
  @@map("payroll_employees")
}

model PayrollRun {
  id                   String   @id @default(uuid())
  runNumber            String   @unique @map("run_number")
  periodMonth          Int      @map("period_month")
  periodYear           Int      @map("period_year")
  periodLabel          String   @map("period_label")
  description          String?
  status               String   @default("draft") @map("status")
  accrualDate          String?  @map("accrual_date")
  accrualTransactionId String?  @map("accrual_transaction_id")
  paymentDate          String?  @map("payment_date")
  paymentAccountCode   String?  @map("payment_account_code")
  paymentAccountName   String?  @map("payment_account_name")
  paymentTransactionId String?  @map("payment_transaction_id")
  totalGross           Decimal  @default(0) @map("total_gross") @db.Decimal(18, 3)
  totalDeductions      Decimal  @default(0) @map("total_deductions") @db.Decimal(18, 3)
  totalNet             Decimal  @default(0) @map("total_net") @db.Decimal(18, 3)
  isDeleted            Boolean  @default(false) @map("is_deleted")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  lines PayrollRunLine[]

  @@index([status])
  @@index([periodYear, periodMonth])
  @@map("payroll_runs")
}

model PayrollRunLine {
  id                  String   @id @default(uuid())
  runId               String   @map("run_id")
  employeeId          String?  @map("employee_id")
  employeeCode        String   @map("employee_code")
  employeeName        String   @map("employee_name")
  department          String?
  costCenterId        String?  @map("cost_center_id")
  costCenterType      String?  @map("cost_center_type")
  costCenterCode      String?  @map("cost_center_code")
  expenseAccountCode  String   @map("expense_account_code")
  expenseAccountName  String?  @map("expense_account_name")
  // Earnings
  basicSalary         Decimal  @default(0) @map("basic_salary") @db.Decimal(18, 3)
  overtime            Decimal  @default(0) @db.Decimal(18, 3)
  bonus               Decimal  @default(0) @db.Decimal(18, 3)
  incentiveKpi        Decimal  @default(0) @map("incentive_kpi") @db.Decimal(18, 3)
  otherEarnings       Decimal  @default(0) @map("other_earnings") @db.Decimal(18, 3)
  grossSalary         Decimal  @default(0) @map("gross_salary") @db.Decimal(18, 3)
  // Deductions
  socialInsurance     Decimal  @default(0) @map("social_insurance") @db.Decimal(18, 3)
  incomeTax           Decimal  @default(0) @map("income_tax") @db.Decimal(18, 3)
  advances            Decimal  @default(0) @db.Decimal(18, 3)
  penalties           Decimal  @default(0) @db.Decimal(18, 3)
  otherDeductions     Decimal  @default(0) @map("other_deductions") @db.Decimal(18, 3)
  totalDeductions     Decimal  @default(0) @map("total_deductions") @db.Decimal(18, 3)
  netSalary           Decimal  @default(0) @map("net_salary") @db.Decimal(18, 3)
  notes               String?
  createdAt           DateTime @default(now()) @map("created_at")

  run         PayrollRun                @relation(fields: [runId], references: [id], onDelete: Cascade)
  employee    PayrollEmployee?          @relation(fields: [employeeId], references: [id])
  allocations PayrollRunLineAllocation[]

  @@index([runId])
  @@index([employeeId])
  @@index([costCenterId])
  @@map("payroll_run_lines")
}

// ─── Payroll: per-employee cost-center split + monthly run-line allocations ─────

model EmployeeCostCenterAllocation {
  id                 String   @id @default(uuid())
  employeeId         String   @map("employee_id")
  costCenterId       String   @map("cost_center_id")
  costCenterType     String?  @map("cost_center_type")
  expenseAccountCode String?  @map("expense_account_code")
  expenseAccountName String?  @map("expense_account_name")
  percentage         Decimal  @default(0) @db.Decimal(9, 4)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  employee PayrollEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("employee_cost_center_allocations")
}

model PayrollRunLineAllocation {
  id                 String   @id @default(uuid())
  runLineId          String   @map("run_line_id")
  costCenterId       String   @map("cost_center_id")
  costCenterType     String?  @map("cost_center_type")
  expenseAccountCode String   @map("expense_account_code")
  expenseAccountName String?  @map("expense_account_name")
  percentage         Decimal  @default(0) @db.Decimal(9, 4)
  amount             Decimal  @default(0) @db.Decimal(18, 3)
  createdAt          DateTime @default(now()) @map("created_at")

  runLine PayrollRunLine @relation(fields: [runLineId], references: [id], onDelete: Cascade)

  @@index([runLineId])
  @@map("payroll_run_line_allocations")
}

// ─── Payroll: WhatsApp salary notification outbox (raw phone, not app user) ─────

model EmployeeNotificationOutbox {
