{
  "name": "react-example",
  "private": true,
  "version": "1.0.7",
  "repository": {
    "type": "git",
    "url": "https://github.com/ahmedbehairi78/web-cost-app.git"
  },
  "description": "Web Cost App desktop shell",
  "author": "Ahmed Behairi <myline78@gmail.com>",
  "type": "module",
  "main": "electron/dist/main.js",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:local": "concurrently -n vite,api -c cyan,green \"npm run dev\" \"npm run local:api\"",
    "desktop:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-desktop-shortcut.ps1",
    "local:api": "node scripts/copy-coa-seed.mjs && prisma generate && tsx server/src/index.ts",
    "local:dev": "tsx server/src/index.ts",
    "local:build-server": "tsc -p server/tsconfig.build.json",
    "local:start": "node dist-server/index.js",
    "start:api": "node dist-server/index.js",
    "start:api:prod": "node scripts/start-api-production.mjs",
    "railway:build": "node scripts/copy-coa-seed.mjs && prisma generate && npm run local:build-server",
    "railway:build:full": "node scripts/copy-coa-seed.mjs && prisma generate && node scripts/generate-vite-env.mjs && npm run build && npm run local:build-server",
    "local:bootstrap-admin": "tsx server/src/scripts/bootstrapAdmin.ts",
    "local:promote-google-admin": "tsx server/src/scripts/promoteGoogleAdminPg.ts",
    "local:set-user-role": "tsx server/src/scripts/setUserRolePg.ts",
    "local:set-user-password": "tsx server/src/scripts/setUserPasswordPg.ts",
    "prod:set-user-password": "tsx server/src/scripts/setUserPasswordPg.ts --production",
    "local:import-firestore": "tsx server/src/scripts/importFirestoreJson.ts",
    "local:migrate": "tsx server/src/scripts/migrateToPostgres.ts",
    "local:import-banks": "tsx server/src/scripts/importBanksFromBackup.ts",
    "local:export-firestore-users": "tsx server/src/scripts/exportFirestoreUsers.ts",
    "local:verify-postgres": "tsx server/src/scripts/verifyPostgresGoldenPaths.ts",
    "local:mobile-test-state": "tsx scripts/peek-mobile-test-state.ts",
    "local:compare-data": "tsx server/src/scripts/compareDataSources.ts",
    "local:repair-coa": "tsx server/src/scripts/repairCoaParentCodes.ts",
    "local:audit-gl": "tsx server/src/scripts/auditMissingGl.ts",
    "local:backfill-gl": "tsx server/src/scripts/backfillMissingGl.ts",
    "local:backfill-boq-rates": "tsx server/src/scripts/backfillBoqRateFields.ts",
    "local:backfill-ipc-custody-boq": "tsx server/src/scripts/backfillIpcCustodyBoqActual.ts",
    "local:reconcile": "tsx server/src/scripts/reconcile.ts",
    "local:sync-email-profiles": "tsx server/src/scripts/syncEmailProfilesFromSqlite.ts",
    "firestore:deploy-rules": "tsx server/src/scripts/deployFirestoreRules.ts",
    "local:boq-report": "tsx server/src/scripts/boqActualCostReport.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:dev": "prisma migrate dev",
    "build": "vite build",
    "build:production": "node scripts/generate-vite-env.mjs && vite build",
    "build:web": "node scripts/generate-vite-env.mjs && vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "dead": "knip",
    "test": "vitest run",
    "test:consumption": "vitest run src/lib/consumptionAllocation.test.ts server/src/accounting/consumptionJournal.test.ts server/src/lib/consumptionAllocation.test.ts",
    "test:overhead": "vitest run src/lib/costCenterAttribution.test.ts server/src/accounting/overheadAllocation.test.ts",
    "test:notifications": "vitest run server/src/lib/notificationFeed.test.ts server/src/middleware/loginRateLimit.test.ts",
    "local:smoke-overhead": "tsx server/src/scripts/smokeOverheadGoldenPath.ts",
    "local:fix-oha-dates": "tsx server/src/scripts/fixOhaEarlyCloseDates.ts",
    "hr:sample-data": "node scripts/generate-hr-sample-data.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "electron:build:shell": "tsc -p electron/tsconfig.json && tsc -p electron/tsconfig.preload.json",
    "electron:dev": "npm run electron:build:shell && electron .",
    "electron:pack": "node scripts/electron-pack.mjs",
    "electron:publish": "node scripts/electron-publish.mjs",
    "branding:sync": "node scripts/sync-branding-svgs.mjs",
    "branding:icons": "npm run branding:sync && node scripts/generate-branding-icons.mjs && node scripts/generate-app-ico.mjs",
    "docs:screenshots": "node scripts/capture-ops-screenshots.mjs",
    "docs:screenshots:manual": "node scripts/capture-ops-screenshots.mjs --manual-login",
    "docs:screenshots:modules": "node scripts/capture-module-screens.mjs",
    "docs:screenshots:modules:manual": "node scripts/capture-module-screens.mjs --manual-login",
    "docs:demo-project": "node scripts/demo-new-project-impact.mjs",
    "docs:demo-boq": "node scripts/demo-boq-materials-seed.mjs",
    "docs:video": "node scripts/record-ops-walkthrough.mjs",
    "docs:video:mux": "node scripts/mux-walkthrough-video.mjs",
    "docs:voice:clone": "node scripts/clone-elevenlabs-voice.mjs",
    "docs:voice:narrate": "node scripts/generate-walkthrough-narration.mjs",
    "docs:promo:narrate": "node scripts/generate-walkthrough-narration.mjs --target=promo-ad",
    "docs:promo": "node scripts/record-ops-walkthrough.mjs --target=promo-ad",
    "docs:promo:mux": "node scripts/mux-walkthrough-video.mjs --target=promo-ad"
  },
  "build": {
    "appId": "com.webcostapp.desktop",
    "productName": "Web Cost App",
    "npmRebuild": false,
    "buildDependenciesFromSource": false,
    "icon": "public/desktop-icon.ico",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/dist/**/*",
      "public/desktop-icon.png",
      "public/desktop-icon.ico",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/desktop-icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "public/desktop-icon.ico",
      "uninstallerIcon": "public/desktop-icon.ico"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ahmedbehairi78",
        "repo": "web-cost-app"
      }
    ]
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.10.0",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "electron-updater": "^6.8.9",
    "express": "^4.21.2",
    "express-session": "^1.19.0",
    "firebase-admin": "^13.10.0",
    "jose": "^6.2.3",
    "pg": "^8.20.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@google/genai": "^1.29.0",
    "@hookform/resolvers": "^5.2.2",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.1.14",
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.19.0",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^4.1.5",
    "arabic-reshaper": "^1.1.0",
    "autoprefixer": "^10.4.21",
    "bidi-js": "^1.0.3",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.3",
    "electron": "^35.7.5",
    "electron-builder": "^25.1.8",
    "ffmpeg-static": "^5.3.0",
    "firebase": "^12.12.0",
    "html2canvas": "^1.4.1",
    "knip": "^6.17.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "playwright": "^1.49.1",
    "prisma": "^7.8.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.74.0",
    "react-hot-toast": "^2.6.0",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.1.5",
    "xlsx": "^0.18.5"
  }
}
