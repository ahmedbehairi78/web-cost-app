# Copy to .env inside web-cost-app. Keys are in Firebase Console → Project settings → Your apps → Web app.
# For local dev without this file, the app reads firebase-applet-config.json instead (vite dev only).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
# Named database ID (Firestore). Optional unless you use a non-default DB.
VITE_FIREBASE_DATABASE_ID=
# Optional: set to true with local emulators
# VITE_USE_EMULATORS=true

# Local LAN PostgreSQL backend
VITE_DATA_BACKEND=local
VITE_API_BASE_URL=/api
# Optional SPA build id (Railway: generate-vite-env copies RAILWAY_GIT_COMMIT_SHA)
# VITE_SPA_BUILD_ID=
LOCAL_API_PORT=3001
# Optional on server if firebase-applet-config.json is absent
FIREBASE_PROJECT_ID=
# Optional: named Firestore DB for server-side email_profiles sync (local backend)
FIREBASE_DATABASE_ID=
# Optional: enables SQLite→email_profiles sync on login / npm run local:sync-email-profiles
# FIREBASE_SERVICE_ACCOUNT_JSON=
# FIREBASE_SERVICE_ACCOUNT_PATH=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/web_cost_app
SQLITE_CORE_ENABLED=true
SQLITE_CORE_DB_PATH=server/data/financial-core.sqlite
SESSION_SECRET=replace-with-a-long-random-secret
CORS_ORIGIN=http://localhost:3000
# Local dev only — Railway Postgres public URL for Settings → Push to production (admin)
# PRODUCTION_DATABASE_URL=postgresql://...@*.proxy.rlwy.net/railway
# Cross-site cookies when UI and API are on different domains (Railway + Vercel)
# SESSION_COOKIE_SAME_SITE=none

# --- Production (Railway API — Phase 6) ---
# NODE_ENV=production
# PORT=3001                    # Railway sets PORT automatically
# DATABASE_URL=                # from linked PostgreSQL service
# SESSION_SECRET=              # openssl rand -base64 48
# CORS_ORIGIN=https://your-frontend.example.com
# FIREBASE_PROJECT_ID=gen-lang-client-0599011721
# SQLITE_CORE_ENABLED=false    # default false when NODE_ENV=production
# Optional: Firestore email sync / user export scripts only
# FIREBASE_DATABASE_ID=ai-studio-ed995a7f-1301-474a-bea7-988b7ce5664c
# FIREBASE_SERVICE_ACCOUNT_JSON=
# WhatsApp notifications (dry-run until Meta Business line is configured)
WHATSAPP_ENABLED=true
WHATSAPP_DRY_RUN=true
# Optional dev redirect — set only for sandbox testing; leave empty normally
# WHATSAPP_REDIRECT_ALL_TO=
APP_PUBLIC_BASE_URL=http://localhost:3000
NOTIFICATION_WORKER_ENABLED=true
ADMIN_PASSWORD=change-this-password

# Optional — external ops guide screenshots (npm run docs:screenshots)
# SCREENSHOT_EMAIL=
# SCREENSHOT_PASSWORD=
# SCREENSHOT_BASE_URL=http://localhost:3000

# Optional — cloned-voice narration for ops walkthrough (npm run docs:voice:*)
# Create key at https://elevenlabs.io — never commit real values
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_VOICE_NAME=Web Cost App Narrator
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
