/// Fiscal / income-statement closing cycle: P&L close → balanced BS approve → opening journal.
/// Opening journals are tagged journal_kind=fiscal_opening so continuous GL totals are not doubled.
model FiscalPeriodClosing {
  id                     String    @id @default(uuid())
  label                  String
  periodStart            String    @map("period_start")
  periodEnd              String    @map("period_end")
  openingDate            String    @map("opening_date")
  /** draft | pl_closed | bs_approved | opening_posted */
  status                 String    @default("draft")
  netProfit              Decimal?  @map("net_profit") @db.Decimal(18, 2)
  balanceGap             Decimal?  @map("balance_gap") @db.Decimal(18, 2)
  plCloseTransactionId   String?   @map("pl_close_transaction_id")
  openingTransactionId   String?   @map("opening_transaction_id")
  periodLockId           String?   @map("period_lock_id")
  plClosedAt             DateTime? @map("pl_closed_at")
  plClosedBy             String?   @map("pl_closed_by")
  bsApprovedAt           DateTime? @map("bs_approved_at")
  bsApprovedBy           String?   @map("bs_approved_by")
  openingPostedAt        DateTime? @map("opening_posted_at")
  openingPostedBy        String?   @map("opening_posted_by")
  notes                  String?
  createdBy              String?   @map("created_by")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  plCloseTransaction Transaction? @relation("FiscalPlCloseTx", fields: [plCloseTransactionId], references: [id])
  openingTransaction Transaction? @relation("FiscalOpeningTx", fields: [openingTransactionId], references: [id])

  @@unique([periodStart, periodEnd])
  @@index([status, periodEnd])
  @@map("fiscal_period_closings")
}

